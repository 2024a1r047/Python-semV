# 6.Write a python program to store one student data as a tuple: name,roll no.,and marks. Display grade based on marks


name = input("Enter student name: ")
roll_no = int(input("Enter roll no.: "))
marks = float(input("Enter marks: "))

student = (name, roll_no, marks)

print("\nStudent Details:")
print("Name:", student[0])
print("Roll No.:", student[1])
print("Marks:", student[2])

# Display grade based on marks
if marks >= 90:
    grade = "A+"
elif marks >= 80:
    grade = "A"
elif marks >= 70:
    grade = "B"
elif marks >= 60:
    grade = "C"
elif marks >= 50:
    grade = "D"
else:
    grade = "F"

print("Grade:", grade)
