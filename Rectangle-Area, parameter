# 2.Instance Methods: Rectangle area and perimeter. Create a rectangle class with length and breath . Use instance method to calculate ots area and perimeter
class Rectangle:
    def _init_(self, length, breadth):
        self.length = length
        self.breadth = breadth
    def calculate_area(self):
        return self.length * self.breadth

    def calculate_perimeter(self):
        return 2 * (self.length + self.breadth)

rect = Rectangle(10, 5)
print(f"Length   : {rect.length}")
print(f"Breadth  : {rect.breadth}")
print(f"Area     : {rect.calculate_area()}")
print(f"Perimeter: {rect.calculate_perimeter()}")
